{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warrior-cats-online",
  "account_id": "8d7808cecdf479b7b2a814df0af9b1b2",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
